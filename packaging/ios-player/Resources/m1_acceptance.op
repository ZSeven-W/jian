{
  "formatVersion": "1.2",
  "version": "1.2",
  "responsive": true,
  "state": {
    "sharedLabel": { "type": "string", "default": "initial" },
    "clicks": { "type": "int", "default": 0 },
    "blurEvents": { "type": "int", "default": 0 },
    "hoverLeaveEvents": { "type": "int", "default": 0 }
  },
  "children": [
    {
      "type": "frame",
      "id": "home-mobile",
      "screen": "/home",
      "breakpoint": { "minWidth": 0, "maxWidth": 480 },
      "width": 320,
      "height": 720,
      "children": [
        { "type": "text", "id": "shared-label", "x": 20, "y": 20, "width": 280, "height": 24, "content": "initial", "bindings": { "content": "$app.sharedLabel" } },
        { "type": "text_input", "id": "field", "x": 20, "y": 60, "width": 200, "height": 36, "value": "mobile", "events": { "onBlur": [{ "set": { "$app.blurEvents": "$app.blurEvents + 1" } }] } },
        { "type": "rectangle", "id": "button", "x": 220, "y": 650, "width": 80, "height": 50, "maxWidth": 60, "constraints": { "h": "right", "v": "bottom" }, "semantics": { "aiName": "mobile_action" }, "events": { "onTap": [{ "set": { "$app.clicks": "$app.clicks + 1" } }], "onHoverLeave": [{ "set": { "$app.hoverLeaveEvents": "$app.hoverLeaveEvents + 1" } }] } },
        {
          "type": "frame",
          "id": "column",
          "x": 20,
          "y": 130,
          "width": 280,
          "height": "fit_content",
          "layout": "vertical",
          "gap": 8,
          "constraints": { "h": "left_right", "v": "top" },
          "children": [
            { "type": "text", "id": "wrapping-text", "width": "fill_container", "height": "fit_content", "textGrowth": "fixed-width", "content": "Responsive acceptance text wraps across several lines when the available column becomes narrow.", "fontSize": 16 },
            { "type": "text", "id": "viewport-caption", "width": "fill_container", "height": 24, "content": "0", "bindings": { "content": "$viewport.width" } },
            { "type": "image", "id": "hero", "width": 64, "height": 48, "src": "https://example.invalid/acceptance.png" }
          ]
        }
      ]
    },
    {
      "type": "frame",
      "id": "home-tablet",
      "screen": "/home",
      "breakpoint": { "minWidth": 480.5, "maxWidth": 1024 },
      "width": 768,
      "height": 720,
      "children": [
        { "type": "text", "id": "shared-label", "x": 20, "y": 20, "width": 728, "height": 24, "content": "initial", "bindings": { "content": "$app.sharedLabel" } },
        { "type": "text_input", "id": "field", "x": 20, "y": 60, "width": 260, "height": 36, "value": "tablet", "events": { "onBlur": [{ "set": { "$app.blurEvents": "$app.blurEvents + 1" } }] } },
        { "type": "rectangle", "id": "button", "x": 648, "y": 650, "width": 100, "height": 50, "maxWidth": 80, "constraints": { "h": "right", "v": "bottom" }, "semantics": { "aiName": "tablet_action" }, "events": { "onTap": [{ "set": { "$app.clicks": "$app.clicks + 1" } }], "onHoverLeave": [{ "set": { "$app.hoverLeaveEvents": "$app.hoverLeaveEvents + 1" } }] } },
        {
          "type": "frame",
          "id": "column",
          "x": 20,
          "y": 130,
          "width": 728,
          "height": "fit_content",
          "layout": "vertical",
          "gap": 8,
          "constraints": { "h": "left_right", "v": "top" },
          "children": [
            { "type": "text", "id": "wrapping-text", "width": "fill_container", "height": "fit_content", "textGrowth": "fixed-width", "content": "Responsive acceptance text wraps across several lines when the available column becomes narrow.", "fontSize": 16 },
            { "type": "text", "id": "viewport-caption", "width": "fill_container", "height": 24, "content": "0", "bindings": { "content": "$viewport.width" } },
            { "type": "image", "id": "hero", "width": 64, "height": 48, "src": "https://example.invalid/acceptance.png" }
          ]
        }
      ]
    },
    {
      "type": "frame",
      "id": "home-desktop",
      "screen": "/home",
      "width": 1280,
      "height": 720,
      "children": [
        { "type": "text", "id": "shared-label", "x": 20, "y": 20, "width": 1240, "height": 24, "content": "initial", "bindings": { "content": "$app.sharedLabel" } },
        { "type": "text_input", "id": "field", "x": 20, "y": 60, "width": 320, "height": 36, "value": "desktop", "events": { "onBlur": [{ "set": { "$app.blurEvents": "$app.blurEvents + 1" } }] } },
        { "type": "rectangle", "id": "button", "x": 1140, "y": 650, "width": 120, "height": 50, "maxWidth": 100, "constraints": { "h": "right", "v": "bottom" }, "semantics": { "aiName": "desktop_action" }, "events": { "onTap": [{ "set": { "$app.clicks": "$app.clicks + 1" } }], "onHoverLeave": [{ "set": { "$app.hoverLeaveEvents": "$app.hoverLeaveEvents + 1" } }] } },
        {
          "type": "frame",
          "id": "column",
          "x": 20,
          "y": 130,
          "width": 1240,
          "height": "fit_content",
          "layout": "vertical",
          "gap": 8,
          "constraints": { "h": "left_right", "v": "top" },
          "children": [
            { "type": "text", "id": "wrapping-text", "width": "fill_container", "height": "fit_content", "textGrowth": "fixed-width", "content": "Responsive acceptance text wraps across several lines when the available column becomes narrow.", "fontSize": 16 },
            { "type": "text", "id": "viewport-caption", "width": "fill_container", "height": 24, "content": "0", "bindings": { "content": "$viewport.width" } },
            { "type": "image", "id": "hero", "width": 64, "height": 48, "src": "https://example.invalid/acceptance.png" }
          ]
        }
      ]
    },
    {
      "type": "frame",
      "id": "settings",
      "screen": "/settings",
      "width": 800,
      "height": 720,
      "children": [
        { "type": "text", "id": "settings-title", "content": "Settings" }
      ]
    }
  ]
}
